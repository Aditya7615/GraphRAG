# ---- LLM (required) -------------------------------------------------------
# Groq API key — fast, free tier
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# ---- Web Search Fallback (optional) ----------------------------------------
# Get a key at https://tavily.com
TAVILY_API_KEY=

# ---- Embeddings (local, no key needed) -------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Chunking --------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=3
BM25_WEIGHT=0.4
CHROMA_WEIGHT=0.6

# ---- API / UI --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
