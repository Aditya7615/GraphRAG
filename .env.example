# ---- LLM (required for /chat) ----------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ---- Embeddings (local, no key needed) -------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# ---- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# ---- Document store --------------------------------------------------------
# auto = try Postgres, fall back to the local JSON store
DOCSTORE_BACKEND=auto
POSTGRES_DSN=postgresql+psycopg2://rag:rag@localhost:5432/ragdb

# ---- Chunking --------------------------------------------------------------
PARENT_CHUNK_TOKENS=2000
CHILD_CHUNK_TOKENS=400

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=12
MAX_PARENTS_IN_CONTEXT=4
MAX_CONTEXT_TOKENS=6000

# ---- API / UI --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
